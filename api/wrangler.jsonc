{
  "name": "closer-api",
  // Closer's own Cloudflare account (vijaytharigopula14), never the TCOS one.
  "account_id": "d26276a0890d95cd31e6a938fa4ee4e5",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "workers_dev": true,
  "vars": {
    "ENVIRONMENT": "production",
    // The app's addresses: the real domain first, the Pages address while people still have it. Not a secret: browsers send it on every request.
    "ALLOWED_ORIGINS": "https://closer.tharigopula.com,https://closer-5jq.pages.dev"
  },
  // Secrets stay in the environment (wrangler secret). Never put values here:
  // DEV_OTP, SERVICE_TOKEN, MSG91_KEY, MSG91_TEMPLATE_ID, RAZORPAY_WEBHOOK_SECRET,
  // RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, LIVEKIT_API_KEY, LIVEKIT_API_SECRET,
  // VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY.
  "triggers": {
    // 20:55 IST builds the next Drop, 21:00 IST sends the reminder.
    "crons": ["25 15 * * *", "30 15 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "closer",
      "database_id": "c4e0ae90-9752-4c6c-885b-f3836bf7e276",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "closer-media"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PLAN_CHAT",
        "class_name": "PlanChat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed Durable Objects run on the free plan; the chat only uses the key-value API.
      "new_sqlite_classes": ["PlanChat"]
    }
  ]
}
